APP_API_TOKEN=change-me-before-lan-mode
APP_PORT=7860
APP_STORAGE_DIR=D:\codex-project\APP\outputs\ai-report-ppt-controller-runtime
CODEX_COMMAND=codex
CODEX_MODE=mock
CODEX_EXEC_ARGS=exec
HERMES_COMMAND=hermes
HERMES_MODE=mock
HERMES_ENDPOINT=
HERMES_API_KEY_ENV=HERMES_API_KEY
HERMES_HEALTH_PATH=/health
HERMES_RUN_PATH=/run
PLANNER_MODE=hermes
CHATGPT_MODE=mock
