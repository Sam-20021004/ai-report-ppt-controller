APP_API_TOKEN=change-me-before-lan-mode
APP_PORT=7860
APP_STORAGE_DIR=D:\codex-project\APP\outputs\ai-report-ppt-controller-runtime
CODEX_COMMAND=codex
CODEX_MODE=cli
CODEX_EXEC_ARGS=exec --sandbox workspace-write -
CODEX_DIAGNOSTIC_TIMEOUT_S=300
WORKFLOW_PROFILE=three_agent_v2
HERMES_COMMAND=hermes
HERMES_MODE=api
HERMES_ENDPOINT=http://127.0.0.1:7788
HERMES_API_KEY_ENV=HERMES_API_KEY
HERMES_HEALTH_PATH=/health
HERMES_RUN_PATH=/run
PLANNER_MODE=hermes
CHATGPT_MODE=cdp
CHATGPT_USE_NEW_CHAT=1
CHATGPT_REPLY_TIMEOUT_S=600
# Readiness probe (does not send a prompt): POST /api/check/chatgpt
# The role baseline only checks ChatGPT readiness and does not send a message.
# Production ChatGPT review may send task content later; do not submit unauthorized sensitive data.
PASS_SCORE=85
MAX_REVIEW_ROUNDS=3
CHROME_CDP_HOST=127.0.0.1
CHROME_CDP_PORT=9222
